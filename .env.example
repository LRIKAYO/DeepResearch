SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
TAVILY_API_KEY=
RESEARCHFLOW_DATABASE_URL=postgresql+psycopg://researchflow:researchflow_dev_only@127.0.0.1:5432/researchflow
RESEARCHFLOW_TEST_DATABASE_URL=postgresql+psycopg://researchflow:researchflow_dev_only@127.0.0.1:5432/researchflow_test
RESEARCHFLOW_LEGACY_OWNER_USER_ID=
RESEARCHFLOW_LANGGRAPH_URL=http://127.0.0.1:2024
RESEARCHFLOW_GRAPH_ID=researchflow
RESEARCHFLOW_BACKEND_URL=http://127.0.0.1:8000
RESEARCHFLOW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Caps how many tool rounds the bounded research loop may take before it stops
# searching and writes up the evidence it already has.
RESEARCHFLOW_MAX_TOOL_ROUNDS=3

# The domestic embedding/chat provider is reachable directly but NOT through a
# proxy; when a system proxy is configured and not running (or cannot reach it),
# every provider call fails with a proxy connection error. Excluding the domestic
# host keeps those calls direct while leaving the web-search proxy in place.
NO_PROXY=api.siliconflow.cn,localhost,127.0.0.1
no_proxy=api.siliconflow.cn,localhost,127.0.0.1
